/* FIGPSO UIL marketing site — recovered/assembled */
@import url('/shared/tokens.css');
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth}
body{
  margin:0; font-family:var(--font); color:var(--text);
  background:var(--bg); overflow-x:hidden;
}
a{color:inherit; text-decoration:none}
img,svg{display:block; max-width:100%}
.site-field{position:fixed; inset:0; z-index:0; pointer-events:none}
.site-grid,.site-scan{position:fixed; inset:0; z-index:0; pointer-events:none}
.ticker{position:fixed; top:0; left:0; right:0; z-index:50; overflow:hidden; height:28px;
  background:rgba(0,0,0,.55); border-bottom:1px solid var(--border); font-family:var(--mono); font-size:11px; color:var(--text-3)}
.ticker-track{display:inline-block; white-space:nowrap; padding:6px 0; animation:ticker 40s linear infinite}
@keyframes ticker{from{transform:translateX(0)} to{transform:translateX(-50%)}}
.scroll-progress{position:fixed; top:28px; left:0; height:2px; width:0; z-index:60; background:var(--acc)}
.topnav{position:sticky; top:28px; z-index:40; display:flex; align-items:center; gap:18px;
  padding:14px 28px; backdrop-filter:blur(14px); background:rgba(5,5,6,.55); border-bottom:1px solid transparent}
.topnav.stuck{border-bottom-color:var(--border); background:rgba(5,5,6,.82)}
.topnav-links{display:flex; gap:16px; flex:1; justify-content:center; font-size:13px; color:var(--text-2)}
.topnav-links a.on,.topnav-links a:hover{color:var(--text)}
.topnav-actions{display:flex; align-items:center; gap:10px}
.view-toggle{display:flex; border:1px solid var(--border); border-radius:var(--radius); overflow:hidden}
.view-toggle button{background:transparent; border:0; color:var(--text-2); padding:6px 10px; font:inherit; cursor:pointer}
.view-toggle button[aria-pressed="true"]{background:var(--acc-soft); color:var(--acc-2)}
.icon-btn{background:transparent; border:1px solid var(--border); border-radius:var(--radius); width:34px; height:34px; color:var(--text-2); cursor:pointer; display:grid; place-items:center}
.icon-btn svg{width:16px; height:16px}
[data-theme="dark"] .ic-sun,[data-theme="light"] .ic-moon{display:none}
.btn{display:inline-flex; align-items:center; gap:8px; padding:10px 16px; border-radius:var(--radius);
  border:1px solid var(--border); background:var(--surface); color:var(--text); font:inherit; cursor:pointer}
.btn.primary{background:var(--acc); border-color:var(--acc); color:#fff}
.btn-arrow{opacity:.8}
.brand{display:flex; align-items:center; gap:11px; font-size:15px}
.uil-wordmark b{font-weight:700}
.uil-wordmark em{font-style:normal; color:var(--acc-2); font-weight:600}
.hero,.chapter,.section{position:relative; z-index:1; padding:80px 28px; max-width:var(--maxw); margin:0 auto}
.hero{min-height:88vh; display:grid; align-items:center; gap:32px}
.hero-copy h1{font-family:var(--font-display); font-size:clamp(2.4rem,5vw,4.2rem); line-height:1.05; margin:0 0 18px}
.hero-copy p{color:var(--text-2); font-size:1.1rem; max-width:34rem}
.hero-cta{display:flex; gap:12px; margin-top:28px; flex-wrap:wrap}
.chapter-head{max-width:720px; margin-bottom:48px}
.chapter-idx{font-family:var(--mono); font-size:12px; letter-spacing:2px; color:var(--acc-2); text-transform:uppercase}
.reveal{opacity:0; transform:translateY(26px); filter:blur(9px); transition:opacity .85s var(--ease-out), transform .85s var(--ease-out), filter .85s var(--ease-out)}
.reveal.in{opacity:1; transform:none; filter:none}
.card, .glass, .panel{background:var(--surface); border:1px solid var(--border); border-radius:var(--radius); backdrop-filter:blur(10px)}
.grid-2{display:grid; grid-template-columns:1.1fr .9fr; gap:28px}
.grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:18px}
@media (max-width:900px){.grid-2,.grid-3,.topnav-links{display:none}.hero{padding-top:120px}}
/* ── recovered fragments ── */

/* ══ UIL cognitive brain (anime.js-style engine) ═══════════════════ */
.uil-brain {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, 0.8fr);
  gap: 22px;
  margin-top: 18px;
  align-items: stretch;
}
@media (max-width: 980px) {
  .uil-brain { grid-template-columns: 1fr; }
}
.ub-stage {
  position: relative;
  min-height: 520px;
  height: clamp(480px, 58vh, 620px);
  border-radius: var(--radius-lg);
  border: 1px solid var(--border);
  background:
    radial-gradient(ellipse at 50% 48%, rgba(59,116,255,0.14), transparent 55%),
    radial-gradient(ellipse at 30% 40%, rgba(180,139,255,0.1), transparent 45%),
    color-mix(in srgb, var(--surface) 55%, transparent);
  overflow: hidden;
  touch-action: none;
}
.ub-synapses {
  position: absolute; inset: 0; width: 100%; height: 100%;
  pointer-events: none; z-index: 1;
}
.ub-link {
  stroke: color-mix(in srgb, var(--acc) 35%, transparent);
  stroke-width: 1.2;
  stroke-dasharray: 4 6;
  opacity: 0.45;
}
.ub-link.on {
  stroke: var(--acc-2);
  stroke-width: 2;
  opacity: 0.95;
  stroke-dasharray: none;
  filter: drop-shadow(0 0 6px var(--acc));
}
.ub-ring-link {
  stroke: color-mix(in srgb, var(--neural) 28%, transparent);
  stroke-width: 1;
  opacity: 0.35;
}
.ub-swarm {
  position: absolute; inset: 0; z-index: 2; pointer-events: none;
}
.ub-mote {
  position: absolute; left: 50%; top: 50%;
  width: 5px; height: 5px; border-radius: 50%;
  background: var(--acc-2);
  box-shadow: 0 0 10px var(--acc);
  opacity: 0.7;
  will-change: transform;
}
.ub-core {
  position: absolute; left: 50%; top: 50%;
  width: 148px; height: 148px;
  transform: translate(-50%, -50%);
  z-index: 3;
  display: grid; place-items: center;
}
.ub-hemi {
  position: absolute; width: 58%; height: 72%;
  border-radius: 55% 45% 50% 50% / 60% 60% 40% 40%;
  background: linear-gradient(145deg, color-mix(in srgb, var(--acc) 35%, #0a1020), color-mix(in srgb, var(--neural) 40%, #0a1020));
  border: 1px solid color-mix(in srgb, var(--acc-2) 45%, transparent);
  opacity: 0.85;
  filter: blur(0.2px);
}
.ub-hemi.left { left: 6%; top: 12%; transform: rotate(-8deg); }
.ub-hemi.right { right: 6%; top: 12%; transform: scaleX(-1) rotate(-8deg);
  background: linear-gradient(145deg, color-mix(in srgb, var(--neural) 40%, #0a1020), color-mix(in srgb, var(--acc) 30%, #0a1020));
}
.ub-core-glow {
  position: absolute; inset: 18%; border-radius: 50%;
  background: radial-gradient(circle, rgba(122,166,255,0.55), transparent 70%);
  z-index: 1;
}
.ub-core-ring {
  position: absolute; inset: 0; border-radius: 50%;
  border: 1.5px solid rgba(74,168,255,0.45);
  border-top-color: transparent;
  border-left-color: transparent;
}
.ub-core-ring.r2 {
  inset: 12px;
  border-color: rgba(180,139,255,0.4);
  border-bottom-color: transparent;
  border-right-color: transparent;
}
.ub-core-label {
  position: relative; z-index: 2; text-align: center;
  font-family: var(--mono);
}
.ub-core-label b {
  display: block; font-family: var(--font-display), sans-serif;
  font-size: 22px; letter-spacing: 0.08em; color: #fff;
  text-shadow: 0 0 18px rgba(59,116,255,0.8);
}
.ub-core-label span {
  font-size: 9.5px; letter-spacing: 0.16em; text-transform: uppercase;
  color: var(--acc-2);
}
.ub-node {
  position: absolute; z-index: 4;
  transform: translate(-50%, -50%);
  width: 74px; min-height: 74px;
  border-radius: 50%;
  border: 1.5px solid color-mix(in srgb, var(--c) 55%, var(--border));
  background: color-mix(in srgb, var(--bg) 72%, transparent);
  backdrop-filter: blur(8px);
  color: var(--text);
  cursor: grab;
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  gap: 2px; padding: 8px;
  transition: border-color 0.25s, box-shadow 0.25s, background 0.25s;
  touch-action: none;
  user-select: none;
}
.ub-node:active { cursor: grabbing; }
.ub-node i {
  font-style: normal; font-family: var(--mono);
  font-size: 9px; letter-spacing: 0.12em; color: var(--c);
}
.ub-node b {
  font-family: var(--font-display), sans-serif;
  font-size: 11px; font-weight: 700; line-height: 1.1;
}
.ub-node:hover, .ub-node.is-on {
  border-color: var(--c);
  background: color-mix(in srgb, var(--c) 18%, var(--bg));
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 40%, transparent), 0 0 28px color-mix(in srgb, var(--c) 35%, transparent);
  z-index: 6;
}
.ub-node.is-on {
  animation: ubNodePulse 1.8s ease-in-out infinite;
}
@keyframes ubNodePulse {
  0%, 100% { box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 40%, transparent), 0 0 22px color-mix(in srgb, var(--c) 30%, transparent); }
  50% { box-shadow: 0 0 0 2px color-mix(in srgb, var(--c) 55%, transparent), 0 0 36px color-mix(in srgb, var(--c) 50%, transparent); }
}
.ub-panel {
  position: relative;
  padding: 26px 24px 22px;
  background: color-mix(in srgb, var(--surface) 72%, transparent);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  min-height: 480px;
}
.ub-panel-tag {
  font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em;
  color: var(--acc-2); text-transform: uppercase; margin-bottom: 12px;
}
.ub-panel h3 {
  font-family: var(--font-display), sans-serif;
  font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -0.03em;
  margin: 0 0 12px; line-height: 1.1;
}
.ub-lead {
  font-size: 14.5px; line-height: 1.6; color: var(--text-2);
  margin: 0 0 16px;
}
.ub-bullets {
  margin: 0 0 18px; padding: 0 0 0 18px;
  color: var(--text-2); font-size: 13.5px; line-height: 1.55;
}
.ub-bullets li { margin-bottom: 8px; }
.ub-bullets li::marker { color: var(--acc-2); }
.ub-file {
  display: flex; flex-direction: column; gap: 6px;
  padding-top: 14px; border-top: 1px solid var(--border);
  font-family: var(--mono); font-size: 10.5px; color: var(--text-3);
  letter-spacing: 0.08em; text-transform: uppercase;
}
.ub-file code {
  font-size: 12px; letter-spacing: 0; text-transform: none;
  color: var(--acc-2); word-break: break-all;
}
.ub-hint {
  margin-top: 16px; font-size: 11.5px; color: var(--text-3);
  font-family: var(--mono); letter-spacing: 0.04em;
}
html[data-view="wireframe"] .ub-stage,
html[data-view="wireframe"] .ub-panel,
html[data-view="wireframe"] .ub-node {
  border-radius: 0 !important;
  backdrop-filter: none !important;
}
@media (max-width: 700px) {
  .ub-stage { min-height: 420px; height: 440px; }
  .ub-node { width: 62px; min-height: 62px; }
  .ub-node b { font-size: 9.5px; }
  .ub-core { width: 110px; height: 110px; }
}
/* ══ exploded cognition turbine (legacy, unused) ═══════════════════ */

/* ══ UIL cognitive machine ═════════════════════════════════════════ */
.uil-machine {
  display: grid;
  grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.85fr);
  gap: 22px;
  margin-top: 18px;
  align-items: stretch;
}
@media (max-width: 980px) {
  .uil-machine { grid-template-columns: 1fr; }
}
.um-chassis {
  position: relative;
  padding: 22px 20px 20px;
  background: color-mix(in srgb, var(--surface) 70%, transparent);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  overflow: hidden;
  display: grid;
  grid-template-columns: 110px 1fr 110px;
  gap: 14px;
  align-items: center;
  min-height: 420px;
}
@media (max-width: 820px) {
  .um-chassis {
    grid-template-columns: 1fr;
    min-height: 0;
  }
  .um-io { text-align: left !important; flex-direction: row; flex-wrap: wrap; gap: 8px 14px; }
}
.um-rail {
  position: absolute; left: 140px; right: 140px; top: 50%;
  height: 2px; transform: translateY(-50%);
  background: linear-gradient(90deg, transparent, var(--acc), var(--neural), transparent);
  opacity: 0.35; pointer-events: none; z-index: 0;
}
@media (max-width: 820px) { .um-rail { display: none; } }
.um-pulse {
  position: absolute; top: 50%; left: var(--px, 12%);
  width: 14px; height: 14px; border-radius: 50%;
  transform: translate(-50%, -50%);
  background: var(--acc-2);
  box-shadow: 0 0 18px var(--acc), 0 0 40px rgba(59,116,255,0.35);
  transition: left 0.45s var(--ease-out, ease);
}
.um-io {
  position: relative; z-index: 1;
  display: flex; flex-direction: column; gap: 4px;
  font-family: var(--mono); font-size: 10.5px;
  letter-spacing: 0.06em; color: var(--text-3);
}
.um-in { text-align: left; }
.um-out { text-align: right; }
.um-io-tag {
  display: inline-block; width: fit-content;
  padding: 3px 8px; border: 1px solid var(--border-hi);
  color: var(--acc-2); letter-spacing: 0.16em; font-size: 9.5px;
}
.um-out .um-io-tag { margin-left: auto; color: var(--neural); }
.um-io b { color: var(--text); font-size: 12.5px; letter-spacing: 0.02em; font-family: var(--font-display), sans-serif; }
.um-io em { font-style: normal; color: var(--text-3); font-size: 10px; }
.um-bays {
  position: relative; z-index: 1;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
}
@media (max-width: 640px) {
  .um-bays { grid-template-columns: repeat(2, minmax(0, 1fr)); }
}
.um-bay {
  appearance: none; cursor: pointer; text-align: left;
  border: 1px solid var(--border);
  background: color-mix(in srgb, var(--bg) 55%, transparent);
  border-radius: 10px;
  padding: 12px 12px 11px;
  color: var(--text-2);
  transition: border-color 0.22s, background 0.22s, transform 0.22s, box-shadow 0.22s;
  min-height: 86px;
  display: flex; flex-direction: column; gap: 4px;
}
.um-bay:hover {
  border-color: color-mix(in srgb, var(--c) 55%, var(--border));
  transform: translateY(-2px);
}
.um-bay.is-on {
  border-color: var(--c);
  background: color-mix(in srgb, var(--c) 14%, var(--bg));
  box-shadow: 0 0 0 1px color-mix(in srgb, var(--c) 35%, transparent), 0 10px 28px rgba(0,0,0,0.22);
  color: var(--text);
}
.um-num {
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.14em;
  color: var(--c);
}
.um-name {
  font-family: var(--font-display), sans-serif;
  font-weight: 700; font-size: 13.5px; line-height: 1.2;
  color: inherit;
}
.um-hint {
  font-family: var(--mono); font-size: 10px; letter-spacing: 0.1em;
  text-transform: uppercase; color: var(--text-3);
}
.um-panel {
  position: relative;
  padding: 26px 24px 22px;
  background: color-mix(in srgb, var(--surface) 78%, transparent);
  border: 1px solid var(--border);
  border-radius: var(--radius-lg);
  min-height: 420px;
}
.um-panel-tag {
  font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em;
  color: var(--acc-2); text-transform: uppercase; margin-bottom: 12px;
}
.um-panel h3 {
  font-family: var(--font-display), sans-serif;
  font-size: clamp(22px, 2.4vw, 30px); letter-spacing: -0.03em;
  margin: 0 0 12px; line-height: 1.1;
}
.um-lead {
  font-size: 14.5px; line-height: 1.6; color: var(--text-2);
  margin: 0 0 16px;
}
.um-bullets {
  margin: 0 0 22px; padding: 0 0 0 18px;
  color: var(--text-2); font-size: 13.5px; line-height: 1.55;
}
.um-bullets li { margin-bottom: 8px; }
.um-bullets li::marker { color: var(--acc-2); }
.um-file {
  display: flex; flex-direction: column; gap: 6px;
  padding-top: 14px; border-top: 1px solid var(--border);
  font-family: var(--mono); font-size: 10.5px; color: var(--text-3);
  letter-spacing: 0.08em; text-transform: uppercase;
}
.um-file code {
  font-size: 12px; letter-spacing: 0; text-transform: none;
  color: var(--acc-2); word-break: break-all;
}
html[data-view="wireframe"] .um-chassis,
html[data-view="wireframe"] .um-panel,
html[data-view="wireframe"] .um-bay {
  border-radius: 0 !important;
  backdrop-filter: none !important;
}
/* ══ exploded cognition turbine (legacy, unused) ═══════════════════ */

.btn {
  display: inline-flex; align-items: center; gap: 8px; justify-content: center;
  padding: 10px 18px; border-radius: var(--radius-lg);
  font-family: var(--font); font-weight: 600; font-size: 13.5px;
  border: 1px solid transparent; cursor: pointer; white-space: nowrap;
  transition: transform 0.3s var(--ease-spring), filter 0.2s, border-color 0.2s, background 0.2s;
}
.btn.big { padding: 13px 24px; font-size: 14.5px; }
.btn.sm { padding: 7px 12px; font-size: 12px; }
.btn.full { width: 100%; }
.btn.primary {
  background: linear-gradient(135deg, var(--acc), color-mix(in srgb, var(--neural) 55%, var(--acc)));
  color: #fff; box-shadow: 0 10px 28px rgba(59, 116, 255, 0.28);
}
.btn.primary:hover { transform: translateY(-2px); filter: brightness(1.06); }
.btn.ghost { border-color: var(--border-hi); color: var(--text); background: color-mix(in srgb, var(--surface) 80%, transparent); }
.btn.ghost:hover { border-color: var(--acc); transform: translateY(-2px); }
.chapter-head { max-width: 720px; margin-bottom: 48px; }
.chapter-idx {
  font-family: var(--mono); font-size: 11px; letter-spacing: 0.18em;
  text-transform: uppercase; color: var(--acc-2);
}
.chapter-head h2 { font-family: var(--font-display); font-size: clamp(28px, 4vw, 46px); font-weight: 800; letter-spacing: -0.025em; margin: 10px 0 14px; line-height: 1.08; }
.chapter-lead { font-size: 15.5px; line-height: 1.65; color: var(--text-2); max-width: 54ch; }
.chapter-idx { font-family: var(--mono); font-size: 13px; color: var(--acc); letter-spacing: 2px; }
.chapter-head h2 { font-family: var(--font-display); font-size: clamp(28px, 4vw, 46px); font-weight: 800; letter-spacing: -0.025em; margin: 10px 0 16px; line-height: 1.08; }
.chapter-lead { font-size: clamp(15px, 1.5vw, 18px); line-height: 1.65; color: var(--text-2); }
.chapter-lead b { color: var(--text); }
.btn {
  display: inline-flex; align-items: center; gap: 8px; justify-content: center;
  padding: 10px 20px; border-radius: 11px; font-weight: 600; font-size: 14px;
  border: 1px solid transparent; cursor: pointer; white-space: nowrap;
  transition: transform 0.3s var(--ease-spring), filter 0.2s, border-color 0.2s, background 0.2s;
}
.btn.big { padding: 14px 26px; font-size: 15px; }
.btn.sm { padding: 7px 14px; font-size: 12.5px; }
.btn.full { width: 100%; }
.btn.primary { background: linear-gradient(135deg, var(--acc), var(--synapse)); color: #fff; box-shadow: 0 10px 30px rgba(59, 116, 255, 0.28); }
.btn.primary:hover { transform: translateY(-3px); filter: brightness(1.08); }
.btn.ghost { border-color: var(--border-hi); color: var(--text); background: var(--surface); }
.btn.ghost:hover { border-color: var(--acc); transform: translateY(-3px); }
.brand { display: flex; align-items: center; gap: 11px; font-size: 15px; letter-spacing: 0.3px; }
.brand-text b { color: var(--acc-2); font-weight: 700; }
.brand-mark { position: relative; width: 30px; height: 30px; flex-shrink: 0; }
.brand-mark.lg { width: 44px; height: 44px; }
.brand-mark .core { position: absolute; inset: 8px; border-radius: 50%; background: linear-gradient(135deg, var(--acc), var(--neural)); box-shadow: 0 0 16px rgba(59, 116, 255, 0.5); }
.brand-mark .orbit { position: absolute; inset: 0; border-radius: 50%; border: 1.5px solid rgba(59, 116, 255, 0.6); border-top-color: transparent; animation: spin 6s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
.topnav-links { display: flex; gap: 26px; }
.reveal { opacity: 0; transform: translateY(26px); filter: blur(9px);
  transition: opacity 0.85s var(--ease-out), transform 0.85s var(--ease-out), filter 0.85s var(--ease-out);
  transition-delay: calc(var(--d, 0) * 90ms); }
.reveal.in { opacity: 1; transform: none; filter: blur(0); }
/* anime.js module drives entrances when CDN loads — avoid CSS fights */
html.anime-on .reveal { transition: none; }
html.anime-on #hero .hero-inner.reveal:not(.in) > * { opacity: 0; }
@media (prefers-reduced-motion: reduce) { .reveal { opacity: 1; transform: none; filter: none; } }
.hstat b { font-family: var(--mono); font-size: 22px; font-weight: 500; color: var(--text); }
.hstat span { font-size: 11.5px; color: var(--text-3); letter-spacing: 0.2px; }
.hstat b.pop-in, .pop-in { animation: popIn 0.55s cubic-bezier(0.34, 1.56, 0.64, 1); }
@keyframes popIn { from { opacity: 0; transform: translateY(6px) scale(0.96); } to { opacity: 1; transform: none; } }
@media (max-width: 620px) { .hero-stats { grid-template-columns: 1fr 1fr; gap: 20px 30px; } }

/* ── rules restored from _recovery fragments (were in the mangled tail) ── */
.hero-title { font-family: var(--font-display); font-size: clamp(38px, 6.6vw, 82px); line-height: 1.02; font-weight: 800; letter-spacing: -0.03em; margin-bottom: 26px; }
.hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; z-index: 0; opacity: 0.18; pointer-events: none; -webkit-mask-image: linear-gradient(180deg, #000 35%, transparent 98%); mask-image: linear-gradient(180deg, #000 35%, transparent 98%); }
.quiet-title { font-family: var(--font-display); font-size: clamp(26px, 3.4vw, 40px); font-weight: 800; letter-spacing: -0.025em; margin: 12px 0 26px; }
.footer-brand { display: flex; align-items: center; gap: 15px; }
.footer-name { font-size: 18px; }
.footer-name b { color: var(--acc-2); }
.footer-sub { font-size: 12.5px; color: var(--text-3); margin-top: 4px; }
.ub-node.is-grab { cursor: grabbing; z-index: 8; }
