  padding: 16px 18px; border-radius: var(--radius);
}
.kg-canvas-hint span {
  font-size: 10px; color: var(--text-3); padding: 4px 10px; border-radius: 100px;
  background: color-mix(in srgb, var(--surface) 75%, transparent);
  border: 1px solid var(--border); backdrop-filter: blur(8px);
}
.kg-canvas-hint span {
  font-size: 10px; color: var(--text-3); padding: 4px 10px; border-radius: 100px;
  background: color-mix(in srgb, var(--surface) 75%, transparent);
  border: 1px solid var(--border); backdrop-filter: blur(8px);
}
.kg-canvas-hint kbd {
  font-family: var(--mono); font-size: 9.5px; padding: 1px 5px; border-radius: 4px;
  background: var(--surface-3); border: 1px solid var(--border-hi); color: var(--acc-2);
}
.kg-legend {
  position: absolute; top: 14px; left: 14px; z-index: 3;
  display: flex; flex-wrap: wrap; gap: 8px; padding: 8px 10px; border-radius: 10px;
}
.kg-legend .lg-item {
  font-size: 10px; color: var(--text-2); display: inline-flex; align-items: center; gap: 5px;
}
.kg-legend .lg-item::before {
  content: ""; width: 8px; height: 8px; border-radius: 2px; background: var(--c);
  box-shadow: 0 0 8px var(--c);
}
body {
  font-family: var(--font);
